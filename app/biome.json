{
    "$schema": "https://biomejs.dev/schemas/latest/schema.json",
    "extends": "//",
    "files": {
        "includes": [
            "src/**/*.{ts,js}",
            "static/smiski-ui/src/**/*.{ts,tsx,js,jsx,json,css}",
            "static/smiski-ui/*.{ts,js}",
            "scripts/**/*.{ts,js,mjs}"
        ]
    },
    "linter": {
        "rules": {
            "correctness": {
                "useImportExtensions": "off"
            }
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
