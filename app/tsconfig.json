{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["node"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "static"]
}
