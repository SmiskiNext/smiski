# Local variables for the Smiski Custom UI build.
#
# Copy to `.env.local` for local UI development:
#   cp app/static/smiski-ui/.env.example app/static/smiski-ui/.env.local
#
# These names carry no `VITE_` prefix: `vite.config.ts` injects them through
# `define`, and the Forge CLI interpolates the same names into
# `app/manifest.yml`. One value per concept, so the declared egress and the
# origins the frontend calls can never drift apart.

# Backend gateway origin. Local Caddy from services/docker/compose.yaml.
# Must match manifest.yml's permissions.external.fetch entries once deployed.
SMISKI_API_BASE_URL=http://localhost:30000

# Backend Spring services currently generate `/api/1/...`.
# If Caddy still routes `/api/v1/...`, align Caddy/backend before pointing at it.
SMISKI_API_VERSION=1

# LiveKit signalling URL used by the in-room client SDK.
LIVEKIT_URL=wss://smiski-meeting-2rcpqikr.livekit.cloud
