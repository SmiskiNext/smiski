# Local Vite variables for the Smiski Custom UI.
#
# Copy to `.env.local` for local UI development:
#   cp app/static/smiski-ui/.env.example app/static/smiski-ui/.env.local

# Keep `mock` for normal frontend work. Use `backend` only when Caddy/backend is running.
VITE_SMISKI_DATA_SOURCE=mock

# In Vite dev, direct transport is useful because there is no Forge resolver context.
# In Forge deploy/tunnel, resolver transport is the expected production path.
VITE_SMISKI_API_TRANSPORT=direct

# Local Caddy gateway from services/docker/compose.yaml.
VITE_SMISKI_API_BASE_URL=http://localhost:30000

# Backend Spring services currently generate `/api/1/...`.
# If Caddy still routes `/api/v1/...`, align Caddy/backend before enabling backend mode.
VITE_SMISKI_API_VERSION=1

# Optional fallback when backend token responses do not include a LiveKit URL.
VITE_SMISKI_LIVEKIT_URL=wss://smiski-meeting-2rcpqikr.livekit.cloud
