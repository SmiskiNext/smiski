# Local shell variables for Forge CLI and Forge resolver development.
#
# Copy to `.env` only on your machine:
#   cp app/.env.example app/.env
#
# Load before running Forge commands when keychain login is unavailable:
#   set -a
#   . app/.env
#   set +a

# Forge CLI authentication. Never commit real values.
FORGE_EMAIL=your-atlassian-email@example.com
FORGE_API_TOKEN=your-forge-cli-api-token

# Backend API gateway reached by Forge resolver functions.
# Use the public Caddy gateway URL in deployed Forge environments.
SMISKI_API_BASE_URL=https://TODO-caddy-gateway.smiski.example

# Temporary prototype resolver variables for `getRoomToken`.
# Replace this flow with backend-issued room tokens before production.
LIVEKIT_API_KEY=zms-livekit-key
LIVEKIT_API_SECRET=change-me-livekit-secret-must-be-at-least-32-chars
LIVEKIT_URL=wss://smiski-meeting-2rcpqikr.livekit.cloud
