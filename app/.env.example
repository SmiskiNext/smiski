# Local shell variables for the Forge CLI (lint/deploy/install).
#
# Copy to `.env` only on your machine:
#   cp app/.env.example app/.env
#
# `pnpm run forge`, `pnpm run deploy`, and `pnpm run install:site` load this
# file automatically when keychain login is unavailable.
#
# The same variables also configure the Custom UI build. Loading this file
# before `pnpm build` keeps manifest.yml and the bundle on identical origins.

# Forge CLI authentication. Never commit real values.
FORGE_EMAIL=your-atlassian-email@example.com
FORGE_API_TOKEN=your-forge-cli-api-token

# Backend API gateway, written into manifest.yml by `pnpm manifest:render` and
# injected into the Custom UI bundle. Use the public Caddy gateway URL in
# deployed Forge environments.
SMISKI_API_BASE_URL=https://TODO-caddy-gateway.smiski.example

# API version path segment, producing `/api/1/...`. Bundle-only; the manifest
# does not interpolate it.
SMISKI_API_VERSION=1

# LiveKit signalling URL, also declared in manifest.yml (client-side egress).
LIVEKIT_URL=wss://smiski-meeting-2rcpqikr.livekit.cloud
