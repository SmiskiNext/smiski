{
    "name": "@smiski/jira-forge-app",
    "version": "0.0.0",
    "description": "Smiski — embedded online-meeting module for Jira (Atlassian Forge, Custom UI)",
    "license": "Apache-2.0",
    "private": true,
    "type": "commonjs",
    "main": "src/index.ts",
    "packageManager": "pnpm@10.0.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "ui:dev": "pnpm --filter smiski-ui dev",
        "ui:build": "pnpm --filter smiski-ui build",
        "build": "pnpm ui:build",
        "test": "pnpm --filter smiski-ui test",
        "lint": "biome check",
        "format": "biome format --write",
        "format:check": "biome format .",
        "typecheck": "tsc --noEmit && pnpm --filter smiski-ui typecheck",
        "deploy": "pnpm build && node scripts/with-env.mjs forge deploy",
        "install:site": "node scripts/with-env.mjs forge install",
        "forge": "node scripts/with-env.mjs forge"
    },
    "dependencies": {
        "@forge/api": "8.0.1-next.0",
        "@forge/kvs": "^2.0.2",
        "@forge/resolver": "2.0.0",
        "@smiskinext/sdks-jira": "1001.0.0-05f20e18",
        "livekit-server-sdk": "^2.17.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@forge/cli": "^13.1.0",
        "@types/node": "^22.0.0",
        "typescript": "^5.5.0"
    }
}
