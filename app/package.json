{
  "name": "@smiski/jira-forge-app",
  "version": "0.0.0",
  "description": "Smiski — embedded online-meeting module for Jira (Atlassian Forge, Custom UI)",
  "license": "Apache-2.0",
  "private": true,
  "type": "commonjs",
  "main": "src/index.ts",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ui:dev": "pnpm --filter smiski-ui dev",
    "ui:build": "pnpm --filter smiski-ui build",
    "build": "pnpm ui:build",
    "test": "pnpm --filter smiski-ui test",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && pnpm --filter smiski-ui lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm --filter smiski-ui typecheck",
    "deploy": "forge deploy",
    "install:site": "forge install"
  },
  "dependencies": {
    "@forge/api": "8.0.1-next.0",
    "@forge/resolver": "2.0.0",
    "livekit-server-sdk": "^2.17.0"
  },
  "devDependencies": {
    "@forge/cli": "^13.1.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
