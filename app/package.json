{
    "name": "@smiski/jira-forge-app",
    "version": "0.0.0",
    "description": "Smiski — embedded online-meeting module for Jira (Atlassian Forge, Custom UI)",
    "license": "Apache-2.0",
    "private": true,
    "type": "commonjs",
    "packageManager": "pnpm@10.0.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "ui:dev": "pnpm --filter smiski-ui dev",
        "ui:build": "pnpm --filter smiski-ui build",
        "build": "pnpm ui:build",
        "test": "pnpm --filter smiski-ui test",
        "lint": "biome check",
        "format": "biome format --write",
        "format:check": "biome format .",
        "typecheck": "pnpm --filter smiski-ui typecheck",
        "manifest:render": "./scripts/render-manifest.sh",
        "deploy": "pnpm build && pnpm manifest:render && forge deploy",
        "install:site": "pnpm manifest:render && forge install",
        "forge": "forge"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@forge/cli": "13.1.0"
    }
}
