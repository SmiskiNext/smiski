{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "anthropic": {
            "npm": "@ai-sdk/anthropic",
            "name": "Anthropic (CI changelog)",
            "options": {
                "baseURL": "{env:ANTHROPIC_API_URL}",
                "apiKey": "{env:ANTHROPIC_API_KEY}"
            }
        }
    }
}
