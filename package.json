{
    "name": "@smiskinext/workspace",
    "version": "0.0.1-SNAPSHOT",
    "description": "Zero Meeting System",
    "type": "module",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "smiski": "pnpm --filter @smiskinext/scripts smiski --",
        "lint": "markdownlint-cli2 --fix '**/*.md'",
        "format": "prettier --write '**/*.{md, json, toml, yaml, yml, sh}'",
        "openapi:tenant": "./services/gradlew -p services/tenant generateOpenApiDocsFromTests",
        "openapi:meet": "./services/gradlew -p services/meet generateOpenApiDocsFromTests",
        "openapi:record": "./services/gradlew -p services/record generateOpenApiDocsFromTests",
        "openapi:generate": "pnpm run openapi:tenant && pnpm run openapi:meet && pnpm run openapi:record",
        "openapi:lint": "redocly lint services/tenant/openapi.yaml services/meet/openapi.yaml services/record/openapi.yaml",
        "openapi": "pnpm run openapi:generate && pnpm run openapi:lint"
    },
    "keywords": [],
    "author": "",
    "license": "Apache-2.0",
    "packageManager": "pnpm@11.10.0",
    "devDependencies": {
        "@commitlint/cli": "^21.2.0",
        "@commitlint/config-conventional": "^21.2.0",
        "@redocly/cli": "^2.37.0",
        "markdownlint-cli2": "^0.23.0",
        "only-allow": "^1.2.2",
        "prettier": "^3.9.4",
        "prettier-plugin-sh": "^0.18.1",
        "prettier-plugin-toml": "^2.0.6"
    }
}
