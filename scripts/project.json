{
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "name": "scripts",
    "sourceRoot": "scripts/src",
    "projectType": "library",
    "targets": {
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm biome check",
                "cwd": "scripts"
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm exec tsc --noEmit",
                "cwd": "scripts"
            }
        }
    }
}
