{
	order jwtauth before handle
}

:80 {
	@cors_preflight method OPTIONS
	@cors_allowed header_regexp Origin ^https?://(localhost|(\\d{1,3}\\.){3}\\d{1,3}):(3000|5173|30000)$
	@auth_public {
		path /api/v1/auth/register /api/v1/auth/login /api/v1/auth/google-login /api/v1/auth/refresh /api/v1/auth/logout /api/v1/auth/forgot-password /api/v1/auth/reset-password /api/v1/auth/verify-otp
	}
	@protected {
		path /api/v1/users* /api/v1/me /api/v1/me/* /api/v1/meetings* /api/v1/recordings* /api/v1/chat*
		not method OPTIONS
		not path /api/*/meetings/*:requestJoin
		not path /api/*/meetings:byShortCode
		not path /api/*/meetings/invite-tokens:validate
	}
	@requestJoinAuthed {
		path /api/*/meetings/*:requestJoin
		not method OPTIONS
		header Authorization *
	}
	@requestJoinGuest {
		path /api/*/meetings/*:requestJoin
		not method OPTIONS
		not header Authorization *
	}
	@user_meetings path /api/v1/users/*/meetings:filter /api/v1/users/*/meetings/*
	@me path /api/v1/me /api/v1/me/*
	@meetings_or_recordings {
		path /api/v1/meetings* /api/v1/recordings*
		not path /api/*/meetings/*:requestJoin
		not path /api/*/meetings:byShortCode
		not path /api/*/meetings/invite-tokens:validate
	}

	header @cors_allowed Access-Control-Allow-Origin "{http.request.header.Origin}"
	header @cors_allowed Access-Control-Allow-Credentials "true"
	header @cors_allowed Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
	header @cors_allowed Access-Control-Allow-Headers "Authorization, Content-Type, X-Requested-With, X-User-ID, X-User-Email"
	header @cors_allowed Vary "Origin"

	respond @cors_preflight 204

	handle_path /livekit* {
		reverse_proxy {$ZMS_HOST_IP}:7880 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Expose-Headers
			header_down -Vary
		}
	}

	handle @auth_public {
		reverse_proxy {$ZMS_HOST_IP}:8181
	}

	handle /api/1/webhooks/livekit {
		reverse_proxy {$ZMS_HOST_IP}:8182
	}

	handle @requestJoinGuest {
		reverse_proxy {$ZMS_HOST_IP}:8182
	}

	handle /api/*/joinRequests/*/events {
		reverse_proxy {$ZMS_HOST_IP}:8182
	}

	handle /api/*/meetings:byShortCode {
		reverse_proxy {$ZMS_HOST_IP}:8182
	}

	handle /api/*/meetings/invite-tokens:validate {
		reverse_proxy {$ZMS_HOST_IP}:8182
	}

	jwtauth @protected {
		sign_key {$JWT_SECRET_BASE64}
		sign_alg HS512
		user_claims sub
		meta_claims "email->email"
	}

	jwtauth @requestJoinAuthed {
		sign_key {$JWT_SECRET_BASE64}
		sign_alg HS512
		user_claims sub
		meta_claims "email->email"
	}

	handle @requestJoinAuthed {
		reverse_proxy {$ZMS_HOST_IP}:8182 {
			header_up X-User-ID "{http.auth.user.id}"
			header_up X-User-Email "{http.auth.user.email}"
		}
	}

	handle @user_meetings {
		reverse_proxy {$ZMS_HOST_IP}:8182 {
			header_up X-User-ID "{http.auth.user.id}"
			header_up X-User-Email "{http.auth.user.email}"
		}
	}

	handle /api/v1/users* {
		reverse_proxy {$ZMS_HOST_IP}:8181 {
			header_up X-User-ID "{http.auth.user.id}"
			header_up X-User-Email "{http.auth.user.email}"
		}
	}

	handle @me {
		reverse_proxy {$ZMS_HOST_IP}:8181 {
			header_up X-User-ID "{http.auth.user.id}"
			header_up X-User-Email "{http.auth.user.email}"
		}
	}

	handle @meetings_or_recordings {
		reverse_proxy {$ZMS_HOST_IP}:8182 {
			header_up X-User-ID "{http.auth.user.id}"
			header_up X-User-Email "{http.auth.user.email}"
		}
	}

	handle /api/v1/chat* {
		reverse_proxy {$ZMS_HOST_IP}:8183 {
			header_up X-User-ID "{http.auth.user.id}"
			header_up X-User-Email "{http.auth.user.email}"
		}
	}

	respond 404
}
