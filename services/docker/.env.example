# Dev native port map
# Apps: user 8181/http + 9090/grpc, meeting 8182, chat 8183, notification 8184
# Infra: user-postgres 8281, meeting-postgres 8282, chat-mongo 8283, valkey 8284, kafka 9094
# LiveKit: 7880/http+ws, 7881/tcp, 7882/udp; RustFS: 9000/api, 30001/console; Gateway: 30000

JWT_SECRET=change-me-in-production-must-be-at-least-32-chars
# Caddy gateway validates JWT — must be base64 of JWT_SECRET above.
# Generate: echo -n "$JWT_SECRET" | base64
JWT_SECRET_BASE64=Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24tbXVzdC1iZS1hdC1sZWFzdC0zMi1jaGFycw==
CURSOR_SECRET=change-me-cursor-secret-must-be-at-least-32-chars
ZMS_INVITE_TOKEN_SECRET=change-me-invite-secret-must-be-at-least-32-chars

POSTGRES_USER=zms_user
POSTGRES_PASSWORD=zms_secret
USER_POSTGRES_DB=zms_users
MEETING_POSTGRES_DB=zms_meetings

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=

# reCAPTCHA for forgot-password abuse protection.
# Disabled by default for local development; set keys when enabling Google verification.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

LIVEKIT_API_KEY=zms-livekit-key
LIVEKIT_API_SECRET=change-me-livekit-secret-must-be-at-least-32-chars

LIVEKIT_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:30000/livekit
LIVEKIT_WEBHOOK_URL=http://caddy/api/1/webhooks/livekit

CHAT_MONGODB_URI=mongodb://chat-mongo:27017/chat_management?replicaSet=rs0
CHAT_JWT_SECRET=change-me-chat-jwt-secret-must-be-at-least-32-chars

RUSTFS_ACCESS_KEY=rustfs-access-key
RUSTFS_SECRET_KEY=rustfs-secret-key-change-me
RUSTFS_BUCKET=recordings
LIVEKIT_RECORDING_ENDPOINT=http://rustfs:9000
LIVEKIT_RECORDING_PUBLIC_ENDPOINT=http://${ZMS_HOST_IP}:9000
LIVEKIT_RECORDING_EGRESS_ENDPOINT=http://rustfs:9000
LIVEKIT_RECORDING_REGION=us-east-1

ZMS_RESEND_API_KEY=change-me-resend-api-key
ZMS_RESEND_FROM_EMAIL=notifications@example.com
ZMS_RESEND_FROM_NAME=Zero Meeting System
INVITATION_JOIN_BASE_URL=http://localhost:3000/join

GATEWAY_URL=http://localhost:30000
ZMS_FIREBASE_PROJECT_ID=
ZMS_GOOGLE_APPLICATION_CREDENTIALS=
ZMS_HOST_IP=192.168.x.x
