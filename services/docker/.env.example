# Environment template for the local development stack.
#
# Copy to services/docker/.env, then fill in the two REQUIRED values below:
#   cp services/docker/.env.example services/docker/.env
#
# Every variable the stack consumes is listed. Values shown are the defaults
# already baked into compose.yaml or each service's application.yaml — an
# unset variable falls back to the same value, so only the REQUIRED entries
# and anything you deliberately change need to be present in your .env.
#
# Entries marked "(reference only)" are read by a service but are NOT forwarded
# into any container by compose.yaml. Compose passes only interpolated values and
# explicit `environment:` keys, so changing a reference-only entry here has no
# effect on a containerised service — it documents the service default and is the
# value to set when running that service natively. Wire it into compose.yaml's
# `environment:` block for the owning service if you need to override it in the
# stack.

# ── REQUIRED — a service fails to start without these ──────────────────────

# Host LAN IP that LiveKit advertises in ICE candidates. Loopback does not work
# under rootless Docker, so this must be a real address on your machine
# (`ip route get 1` or `ipconfig getifaddr en0`). compose.yaml aborts when unset.
SMISKI_HOST_IP=192.168.1.10

# HMAC key for opaque pagination cursors. The shared CursorEncoder bean reads
# app.cursor.secret with no default and is created by both `tenant` and `meet`,
# so both fail to start when this is unset.
CURSOR_SECRET=change-me-cursor-secret-must-be-at-least-32-chars

# Resend credentials for `notification`. EmailProperties.apiKey and
# WebhookProperties.signingSecret are both @NotBlank, and application.yaml maps
# them to empty defaults, so `notification` fails startup validation when either
# is blank. EmailProperties.sender is @NotBlank too but already defaults to a
# real address, so it needs no attention here.
#
# The placeholders below are deliberately fake and only exist so the stack boots.
# Outbound email fails at send time with a fake key, and inbound webhooks fail
# signature verification — both are correct behaviour for local dev. Use real
# credentials from the Resend dashboard to exercise either path.
#
# The signing secret must be valid base64 after the `whsec_` prefix: Svix decodes
# it inside SvixWebhookVerifier's constructor, so a non-base64 value like
# `change-me` fails at bean creation with "Illegal base64 character", not at
# request time. The trailing gitleaks marker keeps the generic-api-key rule from
# flagging this fake value; it is stripped by compose and by the shell.
RESEND_API_KEY=re_placeholder_replace_with_real_key
RESEND_WEBHOOK_SECRET=whsec_bm90LWEtcmVhbC1zZWNyZXQtcmVwbGFjZS1tZQ== # gitleaks:allow

# ── Java service images ─────────────────────────────────────────────────────

# Tag pulled for tenant / meet / notification. Must match the tag produced by
# `./services/gradlew -p services/<name> bootBuildImage`; compose does not
# build these images.
VERSION=0.0.1-SNAPSHOT

# ── Postgres (one instance per service) ─────────────────────────────────────

POSTGRES_USER=smiski_user
POSTGRES_PASSWORD=smiski_secret
TENANT_POSTGRES_DB=tenant
MEET_POSTGRES_DB=meet
NOTIFICATION_POSTGRES_DB=notification

# JDBC URL each service connects with. compose.yaml sets this per service,
# pointing at that service's own instance on the stack network, so the value
# below is not read in the stack. It is the shape the dev profile expects when
# running a service natively against the published host ports
# (tenant 8281, meet 8282, notification 8283).
# (reference only)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tenant

# ── Kafka ───────────────────────────────────────────────────────────────────

# Containers use the internal listener. Natively run services use the dev
# profile, which hardcodes localhost:9094 and ignores this value.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Valkey (application cache; also backs the gateway's permission cache) ───

# Forwarded into all three Spring services. Every service must declare a redis
# host: the shared CacheConfig is gated on spring.data.redis.host, and AOT
# freezes that condition at build time, so a service that leaves it unset can
# never gain a cache manager at runtime.
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=

# ── LiveKit ─────────────────────────────────────────────────────────────────

LIVEKIT_API_KEY=smiski-livekit-key
LIVEKIT_API_SECRET=change-me-livekit-secret-must-be-at-least-32-chars

# Server-to-server signalling URL, resolved inside the stack network.
LIVEKIT_URL=http://livekit-server:7880

# Browser-facing URL. Media ports are published directly to the host, so this
# addresses LiveKit itself rather than the Envoy gateway.
LIVEKIT_WS_URL=ws://localhost:7880

# Points straight at `meet`, not through Envoy: LiveKit is an internal caller
# with no Forge Invocation Token, and the endpoint verifies the LiveKit
# signature itself.
LIVEKIT_WEBHOOK_URL=http://meet:8080/api/1/webhooks/livekit

# (reference only)
LIVEKIT_WEBHOOK_TOPIC=meet.livekit.webhook.internal
LIVEKIT_WEBHOOK_CONSUMER_GROUP=meet-livekit-webhook

# ── Gateway authorization service (services/gateway) ────────────────────────

REDIS_ADDR=valkey:6379
REDIS_USERNAME=
REDIS_TLS=false
JIRA_API_BASE=https://api.atlassian.com
CACHE_TTL=15m
CACHE_STALE_RETENTION=24h
GRPC_PORT=9001

# ── Email (notification) ────────────────────────────────────────────────────

# RESEND_API_KEY and RESEND_WEBHOOK_SECRET are in the REQUIRED block above.
# This one already carries a usable default despite being @NotBlank.
RESEND_SENDER=calendar@smiskinext.io

# (reference only)
EMAIL_DEFAULT_LOCALE=en
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_MS=1000
EMAIL_DEAD_LETTER_SUFFIX=.dlt

# ── Server-sent events (notification) ───────────────────────────────────────

# Envoy's stream_idle_timeout (360s) is set above the stream lifetime so the
# service, not the gateway, decides when a stream ends. Raising this past 360s
# requires raising stream_idle_timeout in envoy/envoy.yaml to match.
SSE_HOST_STREAM_TIMEOUT_MS=300000
SSE_HEARTBEAT_INTERVAL_SECONDS=15

# ── Kafka consumer groups ───────────────────────────────────────────────────

# Left commented deliberately. TENANT_INSTALLED_CONSUMER_GROUP and
# TENANT_UNINSTALLED_CONSUMER_GROUP are read by BOTH `meet` and `notification`,
# which consume the same tenant.tenant.* topics under different default groups.
# Setting either here puts both services in one consumer group, so each event
# reaches only one of them and tenant fan-out silently breaks. Override them
# per service instead, never stack-wide.
# TENANT_INSTALLED_CONSUMER_GROUP=
# TENANT_UNINSTALLED_CONSUMER_GROUP=

# meet-only tenant consumer tuning. (reference only)
TENANT_KAFKA_RETRY_ATTEMPTS=3
TENANT_KAFKA_RETRY_BACKOFF_MS=1000
TENANT_KAFKA_DLT_SUFFIX=.dlt

# notification-only consumer groups. (reference only)
INVITATION_CONSUMER_GROUP=notification-meeting-invitations
INVITEE_RESPONDED_CONSUMER_GROUP=notification-invitee-responded
MEETING_INFO_UPDATED_CONSUMER_GROUP=notification-meeting-info-updated

# ── meet domain settings ────────────────────────────────────────────────────

# (reference only)
MEET_INSTANT_DEFAULT_DURATION=PT1H
MEET_SHORT_CODE_ALPHABET=0123456789abcdefghijklmnopqrstuvwxyz
MEET_SHORT_CODE_LENGTH=10
MEET_SHORT_CODE_MAX_ATTEMPTS=10

# ── Observability (opt-in) ──────────────────────────────────────────────────

# Read only when the stack is started with the observability profile:
#   docker compose -f services/docker/compose.yaml --profile observability up -d
# Without that flag none of these containers start and nothing below is used.
#
# Grafana's own credentials, consumed as GF_SECURITY_ADMIN_USER and
# GF_SECURITY_ADMIN_PASSWORD. They are kept here rather than in any
# application.yaml on purpose: .gitleaks.toml scans `password:` in
# application*.yaml, and a real credential belongs in an untracked .env anyway.
# The default below is Grafana's own and is safe only because the stack is
# local-only — change it before exposing Grafana to anything.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin # gitleaks:allow

# Host paths the in-process cAdvisor exporter reads, both mounted read-only.
# It joins two sources to attribute usage to a container: the kernel's cgroup
# accounting supplies the numbers, Docker's own state supplies the names. With
# only one of them the metrics are either absent or carry no container name.
#
# The defaults are correct for Docker Engine on Linux. Override them when the
# daemon keeps its state elsewhere — a custom `data-root`, or a snap install.
#
# On Docker Desktop (Windows and macOS) the daemon runs inside a VM and neither
# path exists on the host, so the exporter cannot be wired this way. Everything
# else in the profile still works; the per-container CPU and memory panels are
# what stop being populated.
CADVISOR_CGROUP_ROOT=/sys/fs/cgroup
CADVISOR_DOCKER_ROOT=/var/lib/docker

# Host ports the observability components publish. They are fixed in
# compose.yaml rather than interpolated, so these entries document the map
# instead of overriding it:
#   3000  grafana     dashboards and Explore
#   9090  prometheus  target health at /targets
#   3100  loki        push and query API
#   12345 alloy       component health UI
#
# The four exporters (three postgres, one valkey) publish nothing — only
# Prometheus reads them, over the stack network.
#
# The three Java service images must be rebuilt with `bootBuildImage` before
# metrics or JSON logs appear; see AGENTS.md.
