<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>

        <!-- ── local/default profile: human-readable console output ─────────── -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n" />
        </Console>

        <!-- ── k8s profile: structured ECS JSON output ───────────────────────── -->
        <Console name="ConsoleJson" target="SYSTEM_OUT">
            <JsonTemplateLayout
                eventTemplateUri="classpath:EcsLayout.json" />
        </Console>

        <!-- ── docker profile: structured ECS JSON output via Spring Boot's own
            layout, which resolves service.name from spring.application.name and honours
            the logging.structured.* properties ────────────────── -->
        <Console name="ConsoleStructured" target="SYSTEM_OUT">
            <StructuredLogLayout format="ecs" />
        </Console>

    </Appenders>

    <Loggers>

        <SpringProfile name="local | default | dev">
            <Logger name="io.github.smiskinext" level="DEBUG"
                additivity="false">
                <AppenderRef ref="Console" />
            </Logger>
            <Root level="INFO">
                <AppenderRef ref="Console" />
            </Root>
        </SpringProfile>

        <SpringProfile name="k8s">
            <Logger name="io.github.smiskinext" level="DEBUG"
                additivity="false">
                <AppenderRef ref="ConsoleJson" />
            </Logger>
            <Root level="INFO">
                <AppenderRef ref="ConsoleJson" />
            </Root>
        </SpringProfile>

        <SpringProfile name="docker">
            <Logger name="io.github.smiskinext" level="DEBUG"
                additivity="false">
                <AppenderRef ref="ConsoleStructured" />
            </Logger>
            <Root level="INFO">
                <AppenderRef ref="ConsoleStructured" />
            </Root>
        </SpringProfile>

    </Loggers>

</Configuration>
