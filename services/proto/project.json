{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "proto",
    "root": "services/proto",
    "projectType": "library",
    "targets": {
        "buf-lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "buf lint",
                "cwd": "services/proto"
            }
        },
        "buf-breaking": {
            "executor": "nx:run-commands",
            "options": {
                "command": "buf breaking --against '.git#branch=dev'",
                "cwd": "services/proto"
            }
        }
    }
}
